{
  "compaction": {
    "enabled": true
  },
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "theme": "catppuccin-macchiato",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "collapseChangelog": true,
  "packages": [
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-side-chat",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "https://github.com/zereraz/pi-goal",
    "npm:pi-xai-oauth",
    "https://github.com/calesennett/pi-codex-fast",
    "npm:pi-context-view",
    "npm:@monotykamary/pi-vcc",
    "npm:pi-open-tui",
    "npm:@howaboua/pi-codex-imagegen",
    "npm:pi-claude-bridge",
    "npm:pi-you-should-know",
    "git:github.com/dpaluy/pi-auto-handoff",
    "npm:pi-durable-subagents",
    "npm:pi-intercom",
    "git:github.com/johnlindquist/pi-emphasis"
  ]
}
